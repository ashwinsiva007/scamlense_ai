# ==========================================
# ScamLens Configuration Template
# ==========================================

# Application Execution Mode: "mock" | "cloud" | "local"
MODE=mock

# Gemini Cloud Model Settings (used when MODE=cloud)
# Get your API key from Google AI Studio: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here
GEMMA_MODEL=google/gemma-4-9b-it

# Ollama Local Model Settings (used when MODE=local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:latest

# Security & Verification Services
SAFE_BROWSING_KEY=your_google_safe_browsing_key_here
URLHAUS_KEY=your_abuse_ch_urlhaus_key_here

# Backend CORS & Security
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_UPLOAD_MB=8
RATE_LIMIT_PER_MIN=20

# Frontend Environment Variables
NEXT_PUBLIC_API_URL=http://localhost:8000
